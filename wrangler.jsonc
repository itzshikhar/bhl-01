// Cloudflare Workers config: a static site served from ./public (no server code).
// Requests for files in ./public are served directly and are not billed as Worker invocations.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bhl-01",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  }
  // Custom domains (behumanlabs.com, www.behumanlabs.com) are managed in the Cloudflare
  // dashboard under Worker > Settings > Domains & Routes, not here.
}
